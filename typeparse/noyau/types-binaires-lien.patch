+	s = p;
+	e = q;
+	while (s < e && isspace(UCHAR(*s))) {
+	    s++;
+	}
+	while (e > s && isspace(UCHAR(e[-1]))) {
+	    e--;
+	}
+	len = e - s;
+	if (len == 0) {
+	    ERR(interp, "ARITY", "*(%.*s): empty argument", (int) alen, a);
+	    return TCL_ERROR;
+	}
+	if (index == 0) {
+	    Tcl_Size k;
+	    const char *o = s;
+	    Tcl_Size ol = len;
+
+	    if (len >= 7 && memcmp(s, "file://", 7) == 0 && len == 7) {
+		o = "//";
