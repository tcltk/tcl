+		    || (ol == 2 && memcmp(o, "./", 2) == 0)
+		    || (ol == 1 && o[0] == '.'))) {
+		/* ../ ou ../../ ... */
+
+		int ok = (ol >= 3 && ol % 3 == 0);
+
+		for (k = 0; ok && k < ol; k += 3) {
+		    if (memcmp(o + k, "../", 3) != 0) {
