+/*
+ * v18d : the left operand of the "is" node IDX is a tuple assignment,
+ * through parentheses : "((a,b) = Z) is T".
+ */
+static int
+IsLeftTupleAssign(const OpNode *nodes, int idx)
+{
+    int c = nodes[idx].left, depth;
+
+    for (depth = 0; c >= 0 && depth < 64; depth++) {
+	unsigned char lx = nodes[c].lexeme;
+
+	if (lx == ASSIGN) {
+	    return nodes[c].left >= 0 && nodes[nodes[c].left].lexeme == LIST;
+	}
+	if (lx != OPEN_PAREN && lx != NULL_FUNC) {
+	    return 0;
+	}
+	c = nodes[c].right;
+    }
+    return 0;
+}
