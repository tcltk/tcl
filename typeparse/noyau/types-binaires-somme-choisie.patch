     Tcl_DStringAppend(&ds, field, TCL_AUTO_LENGTH);
     Tcl_DStringAppend(&ds, ")", 1);
     hPtr = Tcl_CreateHashEntry(&d->canon, Tcl_DStringValue(&ds), &isNew);
