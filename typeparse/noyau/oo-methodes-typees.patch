 /*
  * ----------------------------------------------------------------------
  *
+ * MethodSig --
+ *
+ *	TIP 764 (v16p for methods): a method's formal argument list may be
+ *	typed, as a proc's is ({int}x, or a product). Reads the signature
+ *	the way [proc] does (TclTypedProcSig): *sigPtr receives it, or NULL
+ *	for a classic list; when the list is a product, *argsObjPtr is
+ *	replaced by "args" (the signature binds the fields at the call, in
+ *	InitArgsAndLocals, as for a proc). The types are read in the current
+ *	namespace (that of the definition), as a proc's are in its own. On
+ *	TCL_OK with a new "args", *ownedPtr is set: the caller releases it.
+ *
+ * ----------------------------------------------------------------------
+ */
+
+static int
+MethodSig(
+    Tcl_Interp *interp,
+    Tcl_Obj *nameObj,		/* Method name, or NULL (constructor...). */
+    const char *procName,
+    Tcl_Obj **argsObjPtr,
+    void **sigPtr,
+    int *ownedPtr)
+{
+    int typedArgs = 0, code;
+    Tcl_Obj *n, *a;
+    Tcl_Size argsLen;
+
+    /*
+     * The callers may pass unowned objects (refCount 0: the property
+     * methods, Tcl_ObjPrintf): never take and drop their last reference
+     * here, read copies of them instead.
+     */
+
+    *sigPtr = NULL;
+    *ownedPtr = 0;
+    if (nameObj == NULL) {
+	n = Tcl_NewStringObj(procName, -1);
+    } else if (nameObj->refCount == 0) {
+	n = Tcl_DuplicateObj(nameObj);
+    } else {
+	n = nameObj;
+    }
+    a = (*argsObjPtr)->refCount == 0 ? Tcl_DuplicateObj(*argsObjPtr)
+	    : *argsObjPtr;
+    Tcl_IncrRefCount(n);
+    Tcl_IncrRefCount(a);
+    code = TclTypedProcSig(interp, n, a, sigPtr, &typedArgs);
+    Tcl_DecrRefCount(n);
+    Tcl_DecrRefCount(a);
+    if (code != TCL_OK) {
+	return TCL_ERROR;
+    }
+    if (typedArgs) {
+	*argsObjPtr = Tcl_NewStringObj("args", 4);
+	Tcl_IncrRefCount(*argsObjPtr);
+	*ownedPtr = 1;
+	return TCL_OK;
+    }
+    if (TclListObjLength(interp, *argsObjPtr, &argsLen) != TCL_OK) {
+	TclTypedSigRelease(*sigPtr);
+	*sigPtr = NULL;
+	return TCL_ERROR;
+    }
+    return TCL_OK;
+}
