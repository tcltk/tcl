  tags configurés : aspect@couleur=\"#1d2433\",police.(poids=bold,taille=18) aspect aspect@police.poids=bold aspect@police.pente=italic aspect@police.(pente=italic,poids=bold) aspect@marge=16 aspect@couleur=\"#2b5c8a\",marge=16,souligne=1 aspect@couleur=\"#4a5468\",police.(famille=Courier,taille=10)
--- changer la table des styles
nouvelle table -> gras rouge
ancien document -> document bloc.para
italique refusé -> ERREUR value "italique x" is not valid for that variant of segment
rouge accepté -> segment.marque
--- relire le widget (te::lire)
aller-retour exact -> 1
type relu -> bloc.titre bloc.para bloc.puces bloc.code bloc.para
chevauchement, coupé -> {segment.texte {Un }} {segment.marque {gras texte}} {segment.texte { avec un pas}} {segment.marque {gras {{sage } {italique {{en it}}}}}} {segment.marque {italique {{alique, } {gras {{et gras dedans}}}}}} {segment.texte .}
chevauchement, erreur -> ERREUR marque "gras" (3.20-3.30) and marque "italique" (3.25-3.52) overlap: they do not nest
deux gras voisins fusionnent -> {gras {{Un texte}}} { avec un passage }
tag non typé : ignoré -> 1
tag typé, valeur hors du type -> ERREUR tag "segment.marque@style=surligne" at 3.0: value "surligne" matches no variant of nomstyle
titre de niveau 7 -> ERREUR tag "bloc.titre@niveau=7" at 1.0: value "7" matches no variant of niveau
texte hors bloc -> bloc.para {{Un paragraphe tapé à la main.}}
--- les noms de tags
  bloc.titre@niveau=2  ->  titre 2
  bloc.para  ->  para
  segment.marque@style=gras  ->  marque gras
  segment.lien@cible="https://wiki.tcl-lang.org/page/Été 2026?q=a.b&x=1_2"  ->  lien {https://wiki.tcl-lang.org/page/Été 2026?q=a.b&x=1_2}
cible relue à l'identique -> 1
--- la syntaxe des notes
  gras,rouge,italique -> gras,italique,rouge {gras {} rouge {} italique {}}
  font.(family=helvetica,size=10),gras -> font.(family=helvetica,size=10),gras {{font family} helvetica {font size} 10 gras {}}
  gras,font.size=10,font.family=helvetica -> font.(family=helvetica,size=10),gras {gras {} {font size} 10 {font family} helvetica}
  size=10,size=12 -> size=12 {size 12}
  font=x,font.size=10 -> font.size=10 {{font size} 10}
  font.size=10,font=x -> font=x {font x}
  a.b.(c=1,d=2),a.e=3 -> a.(b.(c=1,d=2),e=3) {{a b c} 1 {a b d} 2 {a e} 3}
  cible="https://tcl.tk/a,b.c?x=(1)" -> cible=\"https://tcl.tk/a,b.c?x=(1)\" {cible https://tcl.tk/a,b.c?x=(1)}
  "une clé"="é\u00e9 \"q\" \\ fin" -> {"une clé"="éé \"q\" \\ fin"} {{{une clé}} {{éé "q" \ fin}}}
  a=( -> ERREUR bad notes "a=(": key expected at 2
  a.(b=1 -> ERREUR bad notes "a.(b=1": missing ")" at 6
  a="sans fin -> ERREUR bad notes "a="sans fin": missing close-quote
  ,a -> ERREUR bad notes ",a": key expected at 0
forme canonique stable -> 1
la sélection est ignorée -> 1
deux textes voisins fusionnent -> ab
--- apparence : un tag d'aspect par morceau, styles cumulés
para, gras, italique, gras dans italique -> {3.0 aspect} {3.3 aspect@police.poids=bold} {3.8 aspect} {3.25 aspect@police.pente=italic} {3.38 aspect@police.(pente=italic,poids=bold)}
après italique sur « texte », te::habiller -> {1.13 aspect} {3.3 aspect@police.(pente=italic,poids=bold)} {3.8 aspect} {3.25 aspect@police.pente=italic}
relu : les aspects sont ignorés -> {Un } {gras {{italique texte}}}
--- écrire en gabarit : sans guillemets
même document qu'à la main -> 1
mêmes types -> 1
aller-retour -> 1
un lien, attribut cité -> segment.lien https://a.b/c?x=1,2
crochets et barre échappés -> {un [crochet] et une barre \ seule}
un -- dans le contenu -> {gras {{a -- b}}}
balise inconnue -> ERREUR unknown tag "grass": must be a variant of segment or a style (gras, italique, titre1, titre2, titre3, code, puce, alerte)
attribut inconnu -> ERREUR [lien@href=x]: unknown field "href" in segment.lien
attribut manquant -> ERREUR [lien]: field "cible" of segment.lien has no value and no default
style hors du type -> ERREUR [marque@style=surligne]: value "surligne" matches no variant of nomstyle
sans -- -> ERREUR [gras b]: write [head -- content]
crochet non fermé -> ERREUR "[" without "]" in "a [gras -- b"
--- te::ecrire : un interpréteur sûr, des noms courts
même document -> 1
types -> bloc.titre bloc.para bloc.puces
code -> bloc.code
pas de fichier -> ERREUR invalid command name "open"
pas de te:: -> ERREUR invalid command name "te::p"
erreur de balise -> ERREUR unknown tag "grass": must be a variant of segment or a style (gras, italique, titre1, titre2, titre3, code, puce, alerte)
rien n'est gardé ensuite -> 
