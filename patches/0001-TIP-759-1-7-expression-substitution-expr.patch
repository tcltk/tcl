+# Commands covered: expression substitution [(...)] (TIP 759)
+#
+# This file contains a collection of tests for the expression substitution
+# [(expr)] of TIP 759, in scripts, in [subst] and in expressions. Sourcing
+# this file into Tcl runs the tests and generates output for errors. No
+# output means no errors were found.
+#
+# See the file "license.terms" for information on usage and redistribution of
+# this file, and for a DISCLAIMER OF ALL WARRANTIES.
+
+if {"::tcltest" ni [namespace children]} {
+    package require tcltest 2.5
+    namespace import -force ::tcltest::*
+}
+
+::tcltest::loadTestedCommands
+catch [list package require -exact tcl::test [info patchlevel]]
+
+testConstraint testevalex [llength [info commands testevalex]]
+
+# In a word of a command
+
+test exprSubst-1.1 {whole word} {
+    set x [(1+2)]
+} 3
+test exprSubst-1.2 {variables in the expression} {
+    set a 3
+    set x [( $a * 2 )]
+} 6
+test exprSubst-1.3 {in a quoted word} {
+    set a 3
+    set x "v=[($a+1)]!"
+} v=4!
+test exprSubst-1.4 {followed by text in the word} {
+    set x [(1)]+1
+} 1+1
+test exprSubst-1.5 {two substitutions in a word} {
+    set x [( 1+2 )][( 3 )]
+} 33
+test exprSubst-1.6 {")]" is one symbol: no white space inside} -body {
+    set x [( 1+2 ) ]
+} -returnCodes error -match glob -result {invalid character "]"*}
+test exprSubst-1.7 {the first "(" is closed early} {
+    set x [(1)+(2)]
+} 3
+test exprSubst-1.8 {nested parentheses} {
+    set x [( (1+2)*(3+4) )]
+} 21
+test exprSubst-1.9 {function call} {
+    set x [( max(1,2) )]
+} 2
+test exprSubst-1.10 {nested expression substitution} {
+    set x [(1+[(2*3)])]
+} 7
+test exprSubst-1.11 {command substitution inside} {
+    set L {1 2 3}
+    set x [( [llength $L] * 2 )]
+} 6
+test exprSubst-1.12 {brackets and parentheses in strings are skipped} {
+    set x [( {a)]} eq "a)]" )]
+} 1
+test exprSubst-1.13 {close bracket in a quoted string} {
+    set x "[( "]" )]"
+} \]
+test exprSubst-1.14 {in an array index} {
+    set y(2) 7
+    set x $y([(1+1)])
+} 7
+test exprSubst-1.15 {on several lines} {
+    set x [(
+	1 +
+	2
+    )]
+} 3
+test exprSubst-1.16 {in a procedure} -setup {
+    proc p {v} {return [( $v*7 )]}
+} -body {
+    p 6
+} -cleanup {
+    rename p {}
+} -result 42
+test exprSubst-1.17 {in a loop body} {
+    set r {}
+    foreach v {1 2 3} {lappend r [($v*$v)]}
+    set r
+} {1 4 9}
+test exprSubst-1.18 {in a lambda} {
+    apply {{} {set a 5; return [($a**2)]}}
+} 25
+test exprSubst-1.19 {error in the expression} -body {
+    set x [(1/0)]
+} -returnCodes error -result {divide by zero}
+test exprSubst-1.20 {error is catchable} {
+    list [catch {set x [(1/0)]} m] $m
+} {1 {divide by zero}}
+test exprSubst-1.21 {not compiled: Tcl_EvalEx} -constraints testevalex -body {
