+} -body {
+    eval {[(1+2)] !}
+} -cleanup {
+    rename 3 {}
+} -result three!
+test exprSubst-5.9 {expanded: a command name} -setup {
+    proc 3 {} {return three}
+} -body {
+    eval {{*}[(1+2)]}
+} -cleanup {
+    rename 3 {}
+} -result three
+test exprSubst-5.10 {command substitution alone: still a command name} -setup {
+    proc 3 {} {return three}
+} -body {
