+/*
+ *----------------------------------------------------------------------
+ *
+ * AssignFollows --
+ *
+ *	TIP 282. Is the text at START, after any white space, the
+ *	assignment operator "=" (and not "==")?
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+AssignFollows(
+    const char *start,
+    Tcl_Size numBytes)
+{
+    Tcl_Size ws = TclParseAllWhiteSpace(start, numBytes);
+
+    return (ws < numBytes) && (start[ws] == '=')
+	    && ((ws + 1 == numBytes) || (start[ws + 1] != '='));
+}
+
+/*
