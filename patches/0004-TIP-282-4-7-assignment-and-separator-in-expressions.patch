+ *
+ * SimpleLocalName --
+ *
+ *	TIP 282. Is the name of an assignment target simple enough (not
+ *	qualified, not an array element) to be a compiled local variable?
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+SimpleLocalName(
+    Tcl_Obj *nameObj)
+{
+    Tcl_Size length, i;
+    const char *name = TclGetStringFromObj(nameObj, &length);
+
+    for (i = 0; i < length; i++) {
+	if (name[i] == ':' || name[i] == '(' || name[i] == ')') {
+	    return 0;
+	}
+    }
+    return length > 0;
+}
