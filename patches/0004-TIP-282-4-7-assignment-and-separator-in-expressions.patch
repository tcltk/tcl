@@ -0,0 +1,310 @@
+# Commands covered: expr, assignment "=" and separator ";" (TIP 282)
+#
+# This file contains a collection of tests for the assignment and separator
+# operators of TIP 282 in expressions. Sourcing this file into Tcl runs the
+# tests and generates output for errors. No output means no errors were
+# found.
+#
+# See the file "license.terms" for information on usage and redistribution of
+# this file, and for a DISCLAIMER OF ALL WARRANTIES.
+
+if {"::tcltest" ni [namespace children]} {
+    package require tcltest 2.5
+    namespace import -force ::tcltest::*
+}
+
+::tcltest::loadTestedCommands
+catch [list package require -exact tcl::test [info patchlevel]]
+
+testConstraint testexprparser [llength [info commands testexprparser]]
+
+# Assignment
+
+test exprAssign-1.1 {assignment} -setup {
+    unset -nocomplain x
+} -body {
+    set y 2; set z 3
+    list [expr {x = 5*$y + 6*$z}] $x
+} -result {28 28}
+test exprAssign-1.2 {the examples of TIP 282} -setup {
+    unset -nocomplain x w v
+} -body {
+    set y 2; set z 3
+    list [expr {
+	x = 5*$y  + 6*$z;
+	w = $x**2 + $y**2;
+	v = $w**2 + $y**2
+    }] $x $w $v
+} -result {620948 28 788 620948}
+test exprAssign-1.3 {right associative} -setup {
+    unset -nocomplain a b
+} -body {
+    list [expr {a = b = 4}] $a $b
+} -result {4 4 4}
+test exprAssign-1.4 {names that are boolean values} -setup {
+    unset -nocomplain t f y n
+} -body {
+    expr {t = 1; f = 2; y = 3; n = 4}
+    list $t $f $y $n
+} -result {1 2 3 4}
+test exprAssign-1.5 {lower precedence than ?:} -setup {
+    unset -nocomplain c
+} -body {
+    set y 2
+    list [expr {c = $y > 1 ? 10 : 20}] $c
+} -result {10 10}
+test exprAssign-1.6 {assignment in parentheses} -setup {
+    unset -nocomplain x
+} -body {
+    list [expr {(x = 1) + 2}] $x
+} -result {3 1}
+test exprAssign-1.7 {value is a list} -setup {
+    unset -nocomplain x
+} -body {
+    expr {x = (1, 2)}
+    set x
+} -result {1 2}
+test exprAssign-1.8 {variable keeps the assigned string} -setup {
+    unset -nocomplain s
+} -body {
+    expr {s = "0x10"}
+    set s
+} -result 0x10
+test exprAssign-1.9 {write trace} -setup {
+    unset -nocomplain tv trc
+    trace add variable tv write {apply {args {lappend ::trc $args}}}
+} -body {
+    expr {tv = 3}
+    set trc
+} -cleanup {
+    unset -nocomplain tv trc
+} -result {{tv {} write}}
+test exprAssign-1.10 {not compiled} -setup {
+    unset -nocomplain k
+} -body {
+    set e {k = 5}
+    expr $e
+    set k
+} -result 5
+test exprAssign-1.11 {in an expression substitution} -setup {
+    unset -nocomplain q
+} -body {
+    list [set x [(q = 3*4)]] $q
+} -result {12 12}
+
+test exprAssign-1.12 {assignment alone as a command} -setup {
+    unset -nocomplain y
+} -body {
+    set x 1
+    eval {[(y = $x*3)]
+	puts -nonewline ""
