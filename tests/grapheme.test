if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*

}
tcltest::loadTestedCommands

tcltest::testConstraint testintrep [expr {[info commands testintrep] ne {}}]
tcltest::testConstraint testgrapheme [expr {[info commands testgrapheme] ne {}}]

source [file join [file dirname [info script]] tcltests.tcl]
source [file join [file dirname [info script]] ucdUtils.tcl]
namespace eval grapheme::test {
    namespace path [list ::tcltests::ucd ::tcl::mathop]
    variable testCase
    variable comment
    variable testNum
    variable graphemes
    variable text
    variable l
    variable intrep
    const constindex 0

    if {[tcltest::testConstraint testintrep]} {
        variable intrepTypes [list none unichars]
    } else {
        # When running with tclsh (i.e. without testintrep) nullify
        # mock the testintrep command, do not check different intreps
        # and nullify the shimmering checks.
        proc testintrep {type s} {
            if {$type ne "none"} {
                error ""
            }
            return $s
        }
        variable intrepTypes [list none]
    }

    proc tutf8 {s} {
        return [teststringbytes $s]
    }
    proc unichars {s} {
        return [encoding convertto utf-32 $s]
    }

    # The -ucd- tests all run off the test vectors from the Unicode Character
    # Database. The test numbering is based on the corresponding line from
    # the GraphemeBreakTest.txt file and may therefore be unstable.

    ### grapheme next

    tcltests::testnumargs "grapheme next" "string indexVar" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            test grapheme-next-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l {}
                set i 0
                while {[set grapheme [grapheme next $text i]] ne ""} {
                    lappend l $grapheme
                }
                set l
            } -result $graphemes
        }

        # Index value tests. "Normal" integer indices already tested in above loop
        test grapheme-next-indexvar-$intrep-0 {grapheme indexvar undefined} -setup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 2]
        test grapheme-next-indexvar-$intrep-1 {grapheme indexvar negative} -setup {
            set indexvar -1
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 2]
        test grapheme-next-indexvar-$intrep-2 {grapheme indexvar out of bounds} -setup {
            set indexvar 100
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list "" 3]
        test grapheme-next-indexvar-$intrep-3 {grapheme indexvar end} -setup {
            set indexvar end
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list "" 3]
        test grapheme-next-indexvar-$intrep-4 {grapheme indexvar expression} -setup {
            set indexvar end-3
        } -body {
            set text [testintrep $intrep XA\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 3]
        test grapheme-next-indexvar-error-$intrep-0 {grapheme indexvar invalid} -setup {
            set indexvar xyz
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result {bad index "xyz": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-next-indexvar-error-$intrep-1 {grapheme indexvar const} -body {
            set text [testintrep $intrep A\u0308B]
            grapheme next $text constindex
        } -result {can't set "constindex": variable is a constant} -returnCodes error
        test grapheme-next-indexvar-error-$intrep-2 {grapheme indexvar array} -setup {
            unset -nocomplain indexvar
            array set indexvar {}
        } -cleanup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result {can't set "indexvar": variable is array} -returnCodes error

    }

    ### grapheme prev

    tcltests::testnumargs "grapheme prev" "string indexVar" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            test grapheme-prev-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l {}
                set i end
                while {[set grapheme [grapheme prev $text i]] ne ""} {
                    lappend l $grapheme
                }
                lreverse $l
            } -result $graphemes
        }

        # Index value tests. "Normal" integer indices already tested in above loop
        test grapheme-prev-indexvar-$intrep-0 {grapheme indexvar undefined} -setup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-1 {grapheme indexvar negative} -setup {
            set indexvar -1
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list {} 0]
        test grapheme-prev-indexvar-$intrep-2 {grapheme indexvar out of bounds} -setup {
            set indexvar 100
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-3 {grapheme indexvar end} -setup {
            set indexvar end
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-4 {grapheme indexvar expression} -setup {
            set indexvar end-1
        } -body {
            set text [testintrep $intrep XA\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-error-$intrep-0 {grapheme indexvar invalid} -setup {
            set indexvar xyz
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result {bad index "xyz": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-prev-indexvar-error-$intrep-1 {grapheme indexvar const} -body {
            set text [testintrep $intrep A\u0308B]
            grapheme prev $text constindex
        } -result {can't set "constindex": variable is a constant} -returnCodes error
        test grapheme-prev-indexvar-error-$intrep-2 {grapheme indexvar array} -setup {
            unset -nocomplain indexvar
            array set indexvar {}
        } -cleanup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result {can't set "indexvar": variable is array} -returnCodes error
    }

    ### grapheme count

    tcltests::testnumargs "grapheme count" "string" ""

    foreach testCase [getGraphemeData] {
	lassign $testCase testNum comment graphemes
        foreach intrep $intrepTypes {
            test grapheme-count-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                grapheme count $text
            } -result [llength $graphemes]
        }
    }
    test grapheme-count-empty-1.0 $comment -body {
	grapheme count ""
    } -result 0

    ### grapheme index

    tcltests::testnumargs "grapheme index" "string grIndex" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            foreach index [list end-[expr {$len+2}] -1 {*}[lseq $len] $len end end-1 end+1] {
                test grapheme-index-ucd-$intrep-$testNum.$index $comment -body {
                    set text [testintrep $intrep [join $graphemes ""]]
                    grapheme index $text $index
                } -result [lindex $graphemes $index]
            }
        }
        test grapheme-index-invalid-$intrep-1.0 {bad index} -body {
            grapheme index abc notanint
        } -result {bad index "notanint": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
    }

    ### grapheme offset

    tcltests::testnumargs "grapheme offset" "string grIndex" ""

    foreach intrep $intrepTypes {
        foreach testCase [getGraphemeData] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            set offset 0
            for {set i 0} {$i < $len} {incr i} {
                test grapheme-offset-ucd-$intrep-$testNum.$offset $comment -body {
                    set text [testintrep $intrep [join $graphemes ""]]
                    grapheme offset $text $i
                } -result $offset
                incr offset [string length [lindex $graphemes $i]]
            }
        }

        # Invalid index
        test grapheme-offset-invalid-$intrep-1.0 {bad index} -body {
            grapheme offset abc notanint
        } -result {bad index "notanint": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-offset-oob-$intrep-1.0 {Negative index} -body {
            grapheme offset abc -42
        } -result -1
        test grapheme-offset-oob-$intrep-1.1 {Index too large} -body {
            grapheme offset abc 42
        } -result -1
    }

    ### grapheme range

    tcltests::testnumargs "grapheme range" "string grFirst grLast" ""

    foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
	lassign $testCase testNum comment graphemes
	set len [llength $graphemes]
        foreach intrep $intrepTypes {
            foreach grStart [list -1 {*}[lseq $len] $len end end-1] {
                foreach grEnd [list -1 {*}[lseq $len] $len end end-1] {
                    test grapheme-range-ucd-$intrep-$testNum.$grStart:$grEnd $comment -body {
                        set text [testintrep $intrep [join $graphemes ""]]
                        grapheme range $text $grStart $grEnd
                    } -result [join [lrange $graphemes $grStart $grEnd] ""]
                }
            }
        }
    }

    ### grapheme reverse

    tcltests::testnumargs "grapheme reverse" "string" ""

    foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
	lassign $testCase testNum comment graphemes
	set len [llength $graphemes]
        foreach intrep $intrepTypes {
            test grapheme-reverse-ucd-$intrep-$testNum $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                grapheme reverse $text
            } -result [join [lreverse $graphemes] ""]
            
        }
    }

    ### grapheme split

    tcltests::testnumargs "grapheme split" "string" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            test grapheme-split-ucd-$intrep-$testNum $comment -constraints testintrep -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l [grapheme split $text]
                list $l [testintrep type $l]
            } -result [list $graphemes graphemeList]
        }

        test grapheme-split-listop-$intrep-1.0 {
            Verify lappend operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lappend l X] [testintrep type $l]
        } -result [list [list A\u0308 B X] list]

        test grapheme-split-listop-$intrep-2.0 {
            Verify linsert operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            set l2 [linsert $l 0 X]
            list $l2 [testintrep type $l2] [testintrep type $l]
        } -result [list [list X A\u0308 B] list graphemeList]

        test grapheme-split-listop-$intrep-3.0 {
            Verify lindex operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep XA\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lindex $l 1] [testintrep type $l]
        } -result [list A\u0308 graphemeList]

        test grapheme-split-listop-$intrep-4.0 {
            Verify llength operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [llength $l] [testintrep type $l]
        } -result [list 2 graphemeList]

        test grapheme-split-listop-$intrep-5.0 {
            Verify lmap operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lmap e $l {set e}] [testintrep type $l]
        } -result [list [list A\u308 B] graphemeList]

        test grapheme-split-listop-$intrep-6.0 {
            Verify foreach operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            set l2 {}
            foreach e $l {
                lappend l2 $e
            }
            list $l2 [testintrep type $l]
        } -result [list [list A\u308 B] graphemeList]
    }

    ############################ C API tests ################################

    # Runs the script against every test case in the Unicode standard's
    # grapheme break test suite.
    proc testCAPI script {
        upvar 1 testCase testCase
        uplevel 1 [format {
            foreach testCase [getGraphemeData] {
                lassign $testCase testNum comment graphemes
                set text [join $graphemes ""]
                set graphemeWidths [lmap grapheme $graphemes {
                    string length $grapheme
                }]
                set tutf8 [tutf8 $text]
                set unichars [unichars $text]
                %s
            }
        } $script]
    }

    ### Tcl_GraphemeNext
    testCAPI {
        test Tcl_GraphemeNext-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set s $tutf8
            while {[string length $s]} {
                lassign [testgrapheme Tcl_GraphemeNext $s [string length $s]] \
                    grapheme width consumed
                lappend l $grapheme
                lappend w $width
                set s [string range $s $consumed end]
            }
            list $l $w
        } -result [list $graphemes $graphemeWidths]
    }

    test Tcl_GraphemeNext-empty-0 {GraphemeNext empty string} -body {
        lassign [testgrapheme Tcl_GraphemeNext "" 0] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeNext-empty-1 {GraphemeNext empty string, null grWidthPtr} -body {
        lassign [testgrapheme Tcl_GraphemeNext "" 0 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeNext-negative-length-0 {GraphemeNext negative lengths} -body {
        set s [tutf8 A\u0301]\0
        lassign [testgrapheme Tcl_GraphemeNext $s -1] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 2 3]

    test Tcl_GraphemeNext-null-pointer-0 {GraphemeNext null grWidthPtr} -body {
        set s [tutf8 A\u0301B]
        lassign [testgrapheme Tcl_GraphemeNext $s [string length $s] -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 3]

    test Tcl_GraphemeNext-null-pointer-1 {GraphemeNext null grWidthPtr, nul terminated} -body {
        set s [tutf8 A\u0301\0]
        lassign [testgrapheme Tcl_GraphemeNext $s -2 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 3]

    test Tcl_GraphemeNext-invalid-encoding-0 {GraphemeNext truncated encoding} -body {
        set s [tutf8 A\u0301]
        set slen [string length $s]
        lassign [testgrapheme Tcl_GraphemeNext $s [- $slen 1]] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A 1 1]

    test Tcl_GraphemeNext-invalid-encoding-1 {GraphemeNext truncated nul terminated encoding} -body {
        set s [string replace [tutf8 A\u0301] end end \0]
        lassign [testgrapheme Tcl_GraphemeNext $s -1] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A 1 1]

    ### Tcl_GraphemeUniNext
    testCAPI {
        test Tcl_GraphemeUniNext-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set s $unichars
            while {[string length $s]} {
                lassign [testgrapheme Tcl_GraphemeUniNext $s \
                             [/ [string length $s] 4]] \
                    grapheme width consumed
                lappend l $grapheme
                lappend w $width
                set s [string range $s $consumed end]
            }
            list $l $w
        } -result [list $graphemes $graphemeWidths]
    }

    test Tcl_GraphemeUniNext-empty-0 {GraphemeUniNext empty string} -body {
        lassign [testgrapheme Tcl_GraphemeUniNext "" 0] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeUniNext-empty-1 {GraphemeUniNext empty string, null grWidthPtr} -body {
        lassign [testgrapheme Tcl_GraphemeUniNext "" 0 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeUniNext-negative-length-0 {GraphemeUniNext negative lengths} -body {
        set s [unichars A\u0301]\0\0\0\0
        lassign [testgrapheme Tcl_GraphemeUniNext $s -1] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 2 8]

    test Tcl_GraphemeUniNext-null-pointer-0 {GraphemeUniNext null grWidthPtr} -body {
        set s [unichars A\u0301B]
        lassign [testgrapheme Tcl_GraphemeUniNext $s 3 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 8]

    test Tcl_GraphemeUniNext-null-pointer-1 {
        GraphemeUniNext null grWidthPtr, nul terminated
    } -body {
        set s [unichars A\u0301]\0\0\0\0
        lassign [testgrapheme Tcl_GraphemeUniNext $s -2 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 8]

    ### Tcl_GraphemePrev

    testCAPI {
        test Tcl_GraphemePrev-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set s $tutf8
            while {[string length $s]} {
                lassign [testgrapheme Tcl_GraphemePrev $s [string length $s]] \
                    grapheme width consumed
                lappend l $grapheme
                lappend w $width
                set s [string range $s 0 end-$consumed]
            }
            list [lreverse $l] [lreverse $w]
        } -result [list $graphemes $graphemeWidths]
    }

    test Tcl_GraphemePrev-empty-0 {GraphemePrev empty string} -body {
        lassign [testgrapheme Tcl_GraphemePrev "" 0] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemePrev-empty-1 {GraphemePrev empty string, null grWidthPtr} -body {
        lassign [testgrapheme Tcl_GraphemePrev "" 0 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemePrev-negative-length-0 {GraphemePrev negative lengths} -body {
        set s [tutf8 A\u0301]
        lassign [testgrapheme Tcl_GraphemePrev $s -1] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list {} 0 0]

    test Tcl_GraphemePrev-null-pointer-0 {GraphemePrev null grWidthPtr} -body {
        set s [tutf8 XA\u0301]
        lassign [testgrapheme Tcl_GraphemePrev $s [string length $s] -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 3]

    test Tcl_GraphemePrev-invalid-encoding-0 {GraphemePrev truncated encoding} -body {
        set s [tutf8 A\u0301]
        set slen [string length $s]
        lassign [testgrapheme Tcl_GraphemePrev $s [- $slen 1]] grapheme width consumed
        # Cannot check grapheme as a character as it will hold an invalid encoding
        # Just check its byte value
        list [binary encode hex $grapheme] $width $consumed
    } -result [list cc 1 1]

    ### Tcl_GraphemeUniPrev

    testCAPI {
        test Tcl_GraphemeUniPrev-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set s $unichars
            while {[string length $s]} {
                lassign [testgrapheme Tcl_GraphemeUniPrev $s [/ [string length $s] 4]] \
                    grapheme width consumed
                lappend l $grapheme
                lappend w $width
                set s [string range $s 0 end-$consumed]
            }
            list [lreverse $l] [lreverse $w]
        } -result [list $graphemes $graphemeWidths]
    }

    test Tcl_GraphemeUniPrev-empty-0 {GraphemeUniPrev empty string} -body {
        lassign [testgrapheme Tcl_GraphemeUniPrev "" 0] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeUniPrev-empty-1 {GraphemeUniPrev empty string, null grWidthPtr} -body {
        lassign [testgrapheme Tcl_GraphemeUniPrev "" 0 -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list "" 0 0]

    test Tcl_GraphemeUniPrev-negative-length-0 {GraphemeUniPrev negative lengths} -body {
        set s [unichars A\u0301]
        lassign [testgrapheme Tcl_GraphemeUniPrev $s -1] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list {} 0 0]

    test Tcl_GraphemeUniPrev-null-pointer-0 {GraphemeUniPrev null grWidthPtr} -body {
        set s [unichars XA\u0301]
        lassign [testgrapheme Tcl_GraphemeUniPrev $s [/ [string length $s] 4] -nowidthptr] grapheme width consumed
        list $grapheme $width $consumed
    } -result [list A\u0301 0 8]

    ### Tcl_GraphemeCount

    testCAPI {
        test Tcl_GraphemeCount-ucd-$testNum.0 $comment -body {
            testgrapheme Tcl_GraphemeCount $tutf8 [string length $tutf8]
        } -result [llength $graphemes]
    }

    test Tcl_GraphemeCount-empty-0 {GraphemeCount empty string} -body {
        testgrapheme Tcl_GraphemeCount "" 0
    } -result 0

    test Tcl_GraphemeCount-negative-length-0 {GraphemeCount negative lengths} -body {
        set s [tutf8 A\u0301B]\0
        testgrapheme Tcl_GraphemeCount $s -1
    } -result 2

    ### Tcl_GraphemeUniCount

    testCAPI {
        test Tcl_GraphemeUniCount-ucd-$testNum.0 $comment -body {
            testgrapheme Tcl_GraphemeUniCount $unichars [/ [string length $unichars] 4]
        } -result [llength $graphemes]
    }

    test Tcl_GraphemeUniCount-empty-0 {GraphemeUniCount empty string} -body {
        testgrapheme Tcl_GraphemeUniCount "" 0
    } -result 0

    test Tcl_GraphemeUniCount-negative-length-0 {GraphemeUniCount negative lengths} -body {
        set s [unichars A\u0301B]\0\0\0\0
        testgrapheme Tcl_GraphemeUniCount $s -1
    } -result 2

    ### Tcl_GraphemeIndex

    testCAPI {
        test Tcl_GraphemeIndex-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set c {}
            foreach index [lseq [llength $graphemes]] {
                lassign [testgrapheme Tcl_GraphemeIndex $tutf8 [string length $tutf8] $index] grapheme width consumed
                lappend l $grapheme
                lappend w $width
                lappend c $consumed
            }
            list $l $w $c
        } -result [list $graphemes $graphemeWidths [lmap grapheme $graphemes {string length [tutf8 $grapheme]}]]
    }

    test Tcl_GraphemeIndex-negative-length-0 {GraphemeIndex negative lengths} -body {
        set s [tutf8 A\u0301B]\0
        list \
            {*}[testgrapheme Tcl_GraphemeIndex $s -1 0] \
            {*}[testgrapheme Tcl_GraphemeIndex $s -1 1]
    } -result [list A\u0301 2 3 B 1 1]

    test Tcl_GraphemeIndex-null-pointer-0 {GraphemeIndex null grWidthPtr} -body {
        set s [tutf8 A\u0301B]
        testgrapheme Tcl_GraphemeIndex $s [string length $s] 0 -nowidthptr
    } -result [list A\u0301 0 3]

    test Tcl_GraphemeIndex-null-pointer-1 {GraphemeIndex null grNumBytesPtr} -body {
        set s [tutf8 A\u0301B]
        testgrapheme Tcl_GraphemeIndex $s [string length $s] 0 -nonumbytesptr
        # Note grapheme returned is empty with a NULL grNumBytesPtr because the test
        # code does not know how many bytes to return in the string. A real application
        # will not pass grNumBytesPtr as NULL or will do the necessary UTF-8 processing
        # itself which the test code does not do.
    } -result [list {} 2 0]

    test Tcl_GraphemeIndex-null-pointer-2 {
        GraphemeIndex null pointers with out of bounds indices
    } -body {
        set s [tutf8 A\u0301B]
        testgrapheme Tcl_GraphemeIndex $s [string length $s] -1 -nonumbytesptr -nowidthptr
        # Note grapheme returned is empty with a NULL grNumBytesPtr because the test
        # code does not know how many bytes to return in the string. A real application
        # will not pass grNumBytesPtr as NULL or will do the necessary UTF-8 processing
        # itself which the test code does not do.
    } -result [list {} 0 0]

    test Tcl_GraphemeIndex-outofbound-0 {GraphemeIndex negative index} -body {
        set s [tutf8 A\u0301B]
        testgrapheme Tcl_GraphemeIndex $s [string length $s] -1
    } -result [list {} 0 0]

    test Tcl_GraphemeIndex-outofbound-1 {GraphemeIndex index too large} -body {
        set s [tutf8 A\u0301B]
        testgrapheme Tcl_GraphemeIndex $s [string length $s] [string length $s]
    } -result [list {} 0 0]

    ### Tcl_GraphemeUniIndex

    testCAPI {
        test Tcl_GraphemeUniIndex-ucd-$testNum.0 $comment -body {
            set l {}
            set w {}
            set c {}
            foreach index [lseq [llength $graphemes]] {
                lassign [testgrapheme Tcl_GraphemeUniIndex $unichars \
                             [/ [string length $unichars] 4] $index] grapheme width consumed
                lappend l $grapheme
                lappend w $width
                lappend c $consumed
            }
            list $l $w $c
        } -result [list $graphemes $graphemeWidths \
                       [lmap grapheme $graphemes \
                            {string length [unichars $grapheme]}]]
    }

    test Tcl_GraphemeUniIndex-negative-length-0 {GraphemeUniIndex negative lengths} -body {
        set s [unichars A\u0301B]\0\0\0\0
        list \
            {*}[testgrapheme Tcl_GraphemeUniIndex $s -1 0] \
            {*}[testgrapheme Tcl_GraphemeUniIndex $s -1 1]
    } -result [list A\u0301 2 8 B 1 4]

    test Tcl_GraphemeUniIndex-null-pointer-0 {GraphemeUniIndex null grWidthPtr} -body {
        set s [unichars A\u0301B]
        testgrapheme Tcl_GraphemeUniIndex $s [/ [string length $s] 4] 0 -nowidthptr
    } -result [list A\u0301 0 8]

    test Tcl_GraphemeUniIndex-null-pointer-1 {GraphemeUniIndex null grNumBytesPtr} -body {
        set s [unichars A\u0301B]
        testgrapheme Tcl_GraphemeUniIndex $s [/ [string length $s] 4] 0 -nonumbytesptr
    } -result [list A\u0301 2 0]

    test Tcl_GraphemeUniIndex-outofbound-0 {GraphemeUniIndex negative index} -body {
        set s [unichars A\u0301B]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniIndex $s $ulen -1
    } -result [list {} 0 0]

    test Tcl_GraphemeUniIndex-outofbound-1 {GraphemeUniIndex index too large} -body {
        set s [unichars A\u0301B]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniIndex $s $ulen $ulen
    } -result [list {} 0 0]

    test Tcl_GraphemeUniIndex-null-pointer-2 {
        GraphemeUniIndex null pointers with out of bounds indices
    } -body {
        set s [unichars A\u0301B]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeIndex $s $ulen -1 -nonumbytesptr -nowidthptr
    } -result [list {} 0 0]


    ### Tcl_GraphemeRange

    testCAPI {
        foreach grLast [lseq [llength $graphemes]] {
            foreach grFirst [lseq [expr {$grLast+1}]] {
                test Tcl_GraphemeRange-ucd-$testNum.$grFirst-$grLast "$comment $grFirst:$grLast" -body {
                    testgrapheme Tcl_GraphemeRange $tutf8 [string length $tutf8] $grFirst $grLast
                } -result [join [lrange $graphemes $grFirst $grLast] ""]
            }
        }
    }

    test Tcl_GraphemeRange-bounds-0 {GraphemeRange first index negative} -body {
        set s [tutf8 A\u0301BC]
        testgrapheme Tcl_GraphemeRange $s [string length $s] -1 1
    } -result "A\u0301B"

    test Tcl_GraphemeRange-bounds-1 {GraphemeRange first index out of bounds} -body {
        set s [tutf8 A\u0301BC]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeRange $s $slen $slen [incr slen]
    } -result {}

    test Tcl_GraphemeRange-bounds-2 {GraphemeRange last index out of bounds} -body {
        set s [tutf8 A\u0301BC]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeRange $s $slen 0 [incr slen]
    } -result "A\u0301BC"

    test Tcl_GraphemeRange-bounds-3 {GraphemeRange last index negative} -body {
        set s [tutf8 A\u0301BC]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeRange $s $slen 0 -1
    } -result "A\u0301BC"

    test Tcl_GraphemeRange-bounds-4 {GraphemeRange last index less than first} -body {
        set s [tutf8 A\u0301BC]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeRange $s $slen 1 0
    } -result {}

    test Tcl_GraphemeRange-bounds-5 {GraphemeRange equal indices} -body {
        set s [tutf8 XA\u0301Y]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeRange $s $slen 1 1
    } -result "A\u0301"

    test Tcl_GraphemeRange-negative-length-0 {GraphemeRange negative lengths} -body {
        set s [tutf8 A\u0301B]\0
        testgrapheme Tcl_GraphemeRange $s -1 0 10
    } -result A\u0301B

    test Tcl_GraphemeRange-null-pointer-0 {GraphemeRange NULL endPtrPtr} -body {
        set s [tutf8 A\u0301BC]
        testgrapheme Tcl_GraphemeRange $s [string length $s] 0 1 -noendptrptr
        # Without an endptrptr, the test functions do not know the length of the sequence
        # and only return the first char. In real life, everyone should be passing
        # the endptrptr
    } -result A

    ### Tcl_GraphemeUniRange

    testCAPI {
        foreach grLast [lseq [llength $graphemes]] {
            foreach grFirst [lseq [expr {$grLast+1}]] {
                test Tcl_GraphemeUniRange-ucd-$testNum.$grFirst-$grLast "$comment $grFirst:$grLast" -body {
                    set ulen [/ [string length $unichars] 4]
                    testgrapheme Tcl_GraphemeUniRange $unichars $ulen $grFirst $grLast
                } -result [join [lrange $graphemes $grFirst $grLast] ""]
            }
        }
    }

    test Tcl_GraphemeUniRange-bounds-0 {GraphemeUniRange first index negative} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen -1 1
    } -result "A\u0301B"

    test Tcl_GraphemeUniRange-bounds-1 {GraphemeUniRange first index out of bounds} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen $ulen [incr ulen]
    } -result {}

    test Tcl_GraphemeUniRange-bounds-2 {GraphemeUniRange last index out of bounds} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen 0 [incr ulen]
    } -result "A\u0301BC"

    test Tcl_GraphemeUniRange-bounds-3 {GraphemeUniRange last index negative} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen 0 -1
    } -result "A\u0301BC"

    test Tcl_GraphemeUniRange-bounds-4 {GraphemeUniRange last index less than first} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen 1 0
    } -result {}

    test Tcl_GraphemeUniRange-bounds-5 {GraphemeUniRange equal indices} -body {
        set s [unichars XA\u0301Y]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen 1 1
    } -result "A\u0301"

    test Tcl_GraphemeUniRange-negative-length-0 {GraphemeUniRange negative lengths} -body {
        set s [unichars A\u0301B]\0\0\0\0
        testgrapheme Tcl_GraphemeUniRange $s -1 0 10
    } -result A\u0301B

    test Tcl_GraphemeUniRange-null-pointer-0 {GraphemeUniRange NULL endPtrPtr} -body {
        set s [unichars A\u0301BC]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniRange $s $ulen 0 1 -noendptrptr
        # Without an endptrptr, the test functions do not know the length of the sequence
        # and only return the first char. In real life, everyone should be passing
        # the endptrptr
    } -result {}

    ### Tcl_GraphemeReverse

    testCAPI {
        test Tcl_GraphemeReverse-ucd-$testNum.0 $comment -body {
            set slen [string length $tutf8]
            testgrapheme Tcl_GraphemeReverse $tutf8 $slen $slen
        } -result [list [llength $graphemes] [join [lreverse $graphemes] ""]]
    }

    test Tcl_GraphemeReverse-empty-0 {GraphemeReverse empty string} -body {
        testgrapheme Tcl_GraphemeReverse "" 0 0
    } -result [list 0 ""]

    test Tcl_GraphemeReverse-capacity-0 {GraphemeReverse 0 size buffer} -body {
        set s [tutf8 XA\u0301Y]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeReverse $s $slen 0
    } -result -1

    test Tcl_GraphemeReverse-capacity-1 {GraphemeReverse negative size buffer} -body {
        set s [tutf8 XA\u0301Y]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeReverse $s $slen -1
    } -result -1

    test Tcl_GraphemeReverse-capacity-2 {GraphemeReverse larger buffer} -body {
        set s [tutf8 XA\u0301Y]
        set slen [string length $s]
        testgrapheme Tcl_GraphemeReverse $s $slen [incr slen]
    } -result [list 3 YA\u0301X]

    test Tcl_GraphemeReverse-negative-length-0 {GraphemeReverse nul terminated} -body {
        set s [tutf8 XA\u0301Y]\0
        testgrapheme Tcl_GraphemeReverse $s -1 $slen
    } -result [list 3 YA\u0301X]

    ### Tcl_GraphemeUniReverse

    testCAPI {
        test Tcl_GraphemeUniReverse-ucd-$testNum.0 $comment -body {
            set slen [/ [string length $unichars] 4]
            testgrapheme Tcl_GraphemeUniReverse $unichars $slen $slen
        } -result [list [llength $graphemes] [join [lreverse $graphemes] ""]]
    }

    test Tcl_GraphemeUniReverse-empty-0 {GraphemeUniReverse empty string} -body {
        testgrapheme Tcl_GraphemeUniReverse "" 0 0
    } -result [list 0 ""]


    test Tcl_GraphemeUniReverse-capacity-0 {GraphemeUniReverse 0 size buffer} -body {
        set s [unichars XA\u0301Y]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniReverse $s $ulen 0
    } -result -1

    test Tcl_GraphemeUniReverse-capacity-1 {GraphemeUniReverse negative size buffer} -body {
        set s [unichars XA\u0301Y]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniReverse $s $ulen -1
    } -result -1

    test Tcl_GraphemeUniReverse-capacity-2 {GraphemeUniReverse larger buffer} -body {
        set s [unichars XA\u0301Y]
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniReverse $s $ulen [incr ulen]
    } -result [list 3 YA\u0301X]

    test Tcl_GraphemeUniReverse-negative-length-0 {GraphemeUniReverse nul terminated} -body {
        set s [unichars XA\u0301Y]\0\0\0\0
        set ulen [/ [string length $s] 4]
        testgrapheme Tcl_GraphemeUniReverse $s -1 $ulen
    } -result [list 3 YA\u0301X]
}

::tcltest::cleanupTests
namespace delete grapheme::test
return
