if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*

}
tcltest::loadTestedCommands

tcltest::testConstraint testintrep [expr {[info commands testintrep] ne {}}]

source [file join [file dirname [info script]] tcltests.tcl]
source [file join [file dirname [info script]] ucdUtils.tcl]
namespace eval grapheme::test {
    namespace path ::tcltests::ucd
    variable testCase
    variable comment
    variable testNum
    variable graphemes
    variable text
    variable l
    variable intrep
    const constindex 0

    if {[tcltest::testConstraint testintrep]} {
        variable intrepTypes [list none unichars]
        proc shimmered {intrep text} {
            set textIntrep [testintrep type $text]
            if {$intrep eq $textIntrep} {
                return 0
            }
            if {$intrep eq "none" && $textIntrep eq "string"} {
                # The "string" type, but not unichars
                return 0
            }
            return 1
        }
    } else {
        # When running with tclsh (i.e. without testintrep) nullify
        # mock the testintrep command, do not check different intreps
        # and nullify the shimmering checks.
        proc testintrep {type s} {
            if {$type ne "none"} {
                error ""
            }
            return $s
        }
        variable intrepTypes [list none]
        proc shimmered {intrep text} {
            # Make the check always succeed
            return 0
        }
    }

    proc cleanupVars {} {
	unset -nocomplain {*}
    }

    # The -ucd- tests all run off the test vectors from the Unicode Character
    # Database. The test numbering is based on the corresponding line from
    # the GraphemeBreakTest.txt file and may therefore be unstable.

    ### grapheme next

    tcltests::testnumargs "grapheme next" "string indexVar" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            test grapheme-next-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l {}
                set i 0
                while {[set grapheme [grapheme next $text i]] ne ""} {
                    lappend l $grapheme
                }
                list $graphemes [shimmered $intrep $text]
            } -result [list $graphemes 0]
        }

        # Index value tests. "Normal" integer indices already tested in above loop
        test grapheme-next-indexvar-$intrep-0 {grapheme indexvar undefined} -setup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 2]
        test grapheme-next-indexvar-$intrep-1 {grapheme indexvar negative} -setup {
            set indexvar -1
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 2]
        test grapheme-next-indexvar-$intrep-2 {grapheme indexvar out of bounds} -setup {
            set indexvar 100
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list "" 3]
        test grapheme-next-indexvar-$intrep-3 {grapheme indexvar end} -setup {
            set indexvar end
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list "" 3]
        test grapheme-next-indexvar-$intrep-4 {grapheme indexvar expression} -setup {
            set indexvar end-3
        } -body {
            set text [testintrep $intrep XA\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result [list A\u0308 3]
        test grapheme-next-indexvar-error-$intrep-0 {grapheme indexvar invalid} -setup {
            set indexvar xyz
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result {bad index "xyz": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-next-indexvar-error-$intrep-1 {grapheme indexvar const} -body {
            set text [testintrep $intrep A\u0308B]
            grapheme next $text constindex
        } -result {can't set "constindex": variable is a constant} -returnCodes error
        test grapheme-next-indexvar-error-$intrep-2 {grapheme indexvar array} -setup {
            unset -nocomplain indexvar
            array set indexvar {}
        } -cleanup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme next $text indexvar] $indexvar
        } -result {can't set "indexvar": variable is array} -returnCodes error

    }

    ### grapheme prev

    tcltests::testnumargs "grapheme prev" "string indexVar" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            test grapheme-prev-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l {}
                set i end
                while {[set grapheme [grapheme prev $text i]] ne ""} {
                    lappend l $grapheme
                }
                list [lreverse $l] [shimmered $intrep $text]
            } -result [list $graphemes 0]
        }

        # Index value tests. "Normal" integer indices already tested in above loop
        test grapheme-prev-indexvar-$intrep-0 {grapheme indexvar undefined} -setup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-1 {grapheme indexvar negative} -setup {
            set indexvar -1
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list {} 0]
        test grapheme-prev-indexvar-$intrep-2 {grapheme indexvar out of bounds} -setup {
            set indexvar 100
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-3 {grapheme indexvar end} -setup {
            set indexvar end
        } -body {
            set text [testintrep $intrep XA\u0308]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-$intrep-4 {grapheme indexvar expression} -setup {
            set indexvar end-1
        } -body {
            set text [testintrep $intrep XA\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result [list A\u0308 1]
        test grapheme-prev-indexvar-error-$intrep-0 {grapheme indexvar invalid} -setup {
            set indexvar xyz
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result {bad index "xyz": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-prev-indexvar-error-$intrep-1 {grapheme indexvar const} -body {
            set text [testintrep $intrep A\u0308B]
            grapheme prev $text constindex
        } -result {can't set "constindex": variable is a constant} -returnCodes error
        test grapheme-prev-indexvar-error-$intrep-2 {grapheme indexvar array} -setup {
            unset -nocomplain indexvar
            array set indexvar {}
        } -cleanup {
            unset -nocomplain indexvar
        } -body {
            set text [testintrep $intrep A\u0308B]
            list [grapheme prev $text indexvar] $indexvar
        } -result {can't set "indexvar": variable is array} -returnCodes error
    }

    ### grapheme length

    tcltests::testnumargs "grapheme length" "string" ""

    foreach testCase [getGraphemeData] {
	lassign $testCase testNum comment graphemes
        foreach intrep $intrepTypes {
            test grapheme-length-ucd-$intrep-$testNum.0 $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                list [grapheme length $text] [shimmered $intrep $text]
            } -result [list [llength $graphemes] 0]
        }
    }
    test grapheme-length-empty-1.0 $comment -body {
	grapheme length ""
    } -result 0

    ### grapheme index

    tcltests::testnumargs "grapheme index" "string grIndex" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            foreach index [list end-[expr {$len+2}] -1 {*}[lseq $len] $len end end-1 end+1] {
                test grapheme-index-ucd-$intrep-$testNum.$index $comment -body {
                    set text [testintrep $intrep [join $graphemes ""]]
                    list [grapheme index $text $index] [shimmered $intrep $text]
                } -result [list [lindex $graphemes $index] 0]
            }
        }
        test grapheme-index-invalid-$intrep-1.0 {bad index} -body {
            grapheme index abc notanint
        } -result {bad index "notanint": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
    }

    ### grapheme offset

    tcltests::testnumargs "grapheme offset" "string grIndex" ""

    foreach intrep $intrepTypes {
        foreach testCase [getGraphemeData] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            set offset 0
            for {set i 0} {$i < $len} {incr i} {
                test grapheme-offset-ucd-$intrep-$testNum.$offset $comment -body {
                    set text [testintrep $intrep [join $graphemes ""]]
                    list [grapheme offset $text $i] [shimmered $intrep $text]
                } -result [list $offset 0]
                incr offset [string length [lindex $graphemes $i]]
            }
        }

        # Invalid index
        test grapheme-offset-invalid-$intrep-1.0 {bad index} -body {
            grapheme offset abc notanint
        } -result {bad index "notanint": must be integer?[+-]integer? or end?[+-]integer?} -returnCodes error
        test grapheme-offset-oob-$intrep-1.0 {Negative index} -body {
            grapheme offset abc -42
        } -result -1
        test grapheme-offset-oob-$intrep-1.1 {Index too large} -body {
            grapheme offset abc 42
        } -result -1
    }

    ### grapheme range

    tcltests::testnumargs "grapheme range" "string grFirst grLast" ""

    foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
	lassign $testCase testNum comment graphemes
	set len [llength $graphemes]
        foreach intrep $intrepTypes {
            foreach grStart [list -1 {*}[lseq $len] $len end end-1] {
                foreach grEnd [list -1 {*}[lseq $len] $len end end-1] {
                    test grapheme-range-ucd-$intrep-$testNum.$grStart:$grEnd $comment -body {
                        set text [testintrep $intrep [join $graphemes ""]]
                        list [grapheme range $text $grStart $grEnd] [shimmered $intrep $text]
                    } -result [list [join [lrange $graphemes $grStart $grEnd] ""] 0]
                }
            }
        }
    }

    ### grapheme reverse

    tcltests::testnumargs "grapheme reverse" "string" ""

    foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
	lassign $testCase testNum comment graphemes
	set len [llength $graphemes]
        foreach intrep $intrepTypes {
            test grapheme-reverse-ucd-$intrep-$testNum $comment -body {
                set text [testintrep $intrep [join $graphemes ""]]
                list [grapheme reverse $text] [shimmered $intrep $text]
            } -result [list [join [lreverse $graphemes] ""] 0]
            
        }
    }

    ### grapheme split

    tcltests::testnumargs "grapheme split" "string" ""

    foreach intrep $intrepTypes {
        foreach testCase [list [list 0 "empty string" ""] {*}[getGraphemeData]] {
            lassign $testCase testNum comment graphemes
            set len [llength $graphemes]
            test grapheme-split-ucd-$intrep-$testNum $comment -constraints testintrep -body {
                set text [testintrep $intrep [join $graphemes ""]]
                set l [grapheme split $text]
                list $l [testintrep type $l] [shimmered $intrep $text]
            } -result [list $graphemes graphemeList 0]
        }

        test grapheme-split-listop-$intrep-1.0 {
            Verify lappend operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lappend l X] [testintrep type $l]
        } -result [list [list A\u0308 B X] list]

        test grapheme-split-listop-$intrep-2.0 {
            Verify linsert operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            set l2 [linsert $l 0 X]
            list $l2 [testintrep type $l2] [testintrep type $l]
        } -result [list [list X A\u0308 B] list graphemeList]

        test grapheme-split-listop-$intrep-3.0 {
            Verify lindex operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep XA\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lindex $l 1] [testintrep type $l]
        } -result [list A\u0308 graphemeList]

        test grapheme-split-listop-$intrep-4.0 {
            Verify llength operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [llength $l] [testintrep type $l]
        } -result [list 2 graphemeList]

        test grapheme-split-listop-$intrep-5.0 {
            Verify lmap operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            list [lmap e $l {set e}] [testintrep type $l]
        } -result [list [list A\u308 B] graphemeList]

        test grapheme-split-listop-$intrep-6.0 {
            Verify foreach operation on grapheme lists
        } -constraints testintrep -setup {
            set text [testintrep $intrep A\u0308B]
            set l [grapheme split $text]
        } -body {
            set l2 {}
            foreach e $l {
                lappend l2 $e
            }
            list $l2 [testintrep type $l]
        } -result [list [list A\u308 B] graphemeList]
    }

}

::tcltest::cleanupTests
namespace delete grapheme::test
return
