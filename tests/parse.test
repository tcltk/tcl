test parse-21.0 {Bug 1884496} testevent {
    set ::script {testevent delete a; set a [p]; set ::done $a}
    proc ::p {} {string first s $::script}
    testevent queue a head $::script
    vwait done
} {}
test parse-21.1 {TCL_EVAL_DIRECT coverage} testevent {
    testevent queue a head {testevent delete a; \
	set ::done [dict get [info frame 0] line]}
    vwait done
    set ::done
} 2

# Expression substitution: $((expr)) means [expr {expr}] wherever a $
# substitution is recognised. The body is handed to the expression parser as
# one unsubstituted word, so nothing in it is substituted twice.
# (When built with TCL_EXPR_SUBST_PARENS=1, "$(expr)" means the same thing.)

test parse-22.1 {expression substitution: token structure} -constraints testparser -body {
    testparser {puts $((1+2))} 0
} -result [string map [list %L $lp %R $rp] {- {puts $((1+2))} 2 simple puts 1 text puts 0 word {$((1+2))} 2 exprsubst {$((1+2))} 1 text %L1+2%R 0 {}}]
test parse-22.2 {expression substitution: inside a quoted word} -constraints testparser -body {
    testparser {x "a$(((1+2)*3))b"} 0
} -result [string map [list %L $lp %R $rp] {- {x "a$(((1+2)*3))b"} 2 simple x 1 text x 0 word {"a$(((1+2)*3))b"} 4 text a 0 exprsubst {$(((1+2)*3))} 1 text %L(1+2)*3%R 0 text b 0 {}}]
test parse-22.3 {expression substitution: inner parentheses are part of the body} -constraints testparser -body {
    testparser {$(((1+2)*3))} 0
} -result [string map [list %L $lp %R $rp] {- {$(((1+2)*3))} 1 word {$(((1+2)*3))} 2 exprsubst {$(((1+2)*3))} 1 text %L(1+2)*3%R 0 {}}]
test parse-22.4 {expression substitution: Tcl_ParseVarName} -constraints testparsevarname -body {
    testparsevarname {$((1+(2*3)))z} 20 0
} -result [string map [list %L $lp %R $rp] {- {} 0 exprsubst {$((1+(2*3)))} 1 text %L1+(2*3)%R 0 z}]
test parse-22.5 {expression substitution: Tcl_ParseVar result stays valid} testparsevar {
    lindex [testparsevar {$((7*6))z}] 0
} 42
test parse-22.6 {expression substitution: body is not substituted by the parser} -constraints testparser -body {
    testparser {$(($x [y] \n))} 0
} -result [string map [list %L $lp %R $rp] {- {$(($x [y] \n))} 1 word {$(($x [y] \n))} 2 exprsubst {$(($x [y] \n))} 1 text {%L$x [y] \n%R} 0 {}}]

