    set v $((1+2))
} 3
test parse-22.11 {expression substitution: inside quotes} {
    set v "n=$((3*4))!"
} n=12!
test parse-22.12 {expression substitution: several in one word} {
    set v a$((1+1))b$((2+2))c
} a2b4c
test parse-22.13 {expression substitution: extra parentheses} {
    set v $(((1+2)*3))
} 9
test parse-22.14 {expression substitution: variables are substituted by expr} {
    set x 5
    set v $(($x*2))
} 10
test parse-22.15 {expression substitution: the body is not substituted first} {
    # If the word parser substituted $x first this would be the (erroneous)
    # command [llength a b].
    set x {a b}
    set v $(([llength $x]))
} 2
test parse-22.16 {expression substitution: no double substitution} {
    # The *value* of a variable inside the body is never substituted again.
    set cnt 0
    set s {[incr cnt]}
    list $(([string length $s])) $cnt
} {10 0}
test parse-22.17 {expression substitution: close paren inside braces} {
    set v $(([llength {a b )}]))
} 3
test parse-22.18 {expression substitution: close paren inside quotes} {
    set v $(([string length ")"]))
} 1
test parse-22.19 {expression substitution: close paren inside a script} {
    set v $(([string length [string trim " ) "]]))
} 1
test parse-22.20 {expression substitution: nested} {
    set v $(($((1+1))+1))
} 3
test parse-22.21 {expression substitution: as an array index} {
    unset -nocomplain ax
    array set ax {2 two}
    set v $ax($((1+1)))
} two
test parse-22.22 {expression substitution: in bracketed command} {
    list $((1+1)) $((2+2))
} {2 4}
